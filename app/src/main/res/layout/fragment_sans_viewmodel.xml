<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:text="⚠️ SANS ViewModel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#E53935"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:text="Variable classique — perdue à la rotation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#999999"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/tvCount1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="80sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnIncrement1"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="INCRÉMENTER"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnDecrement1"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="DÉCRÉMENTER"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnReset1"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="RÉINITIALISER"/>

</LinearLayout>